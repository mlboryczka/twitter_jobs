# Database
DATABASE_URL=postgresql+asyncpg://twitter_jobs:PASSWORD@localhost:5432/twitter_jobs

# X API (OAuth 2.0 app credentials from developer portal)
X_CLIENT_ID=
X_CLIENT_SECRET=
X_USER_NUMERIC_ID=          # your X user ID, numeric
X_USERNAME=                 # your X handle, without @
X_REDIRECT_URI=http://localhost:8765/callback

# Refresh token — populated by scripts/run_oauth_flow.py
X_REFRESH_TOKEN=

# Anthropic
ANTHROPIC_API_KEY=

# Dashboard auth
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=

# App
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# Scheduler intervals (seconds)
FEED_PULL_INTERVAL=14400    # 4 hours
